<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Calculator operator key (÷ × − +): accent tint, so the operators read apart
     from the digits without adding another colour to the palette. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/brand_purple_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_purple_tint" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
