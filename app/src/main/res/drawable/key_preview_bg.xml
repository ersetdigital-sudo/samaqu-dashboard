<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded bubble behind the key preview popup, like Gboard's key popup. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/key_preview_bg" />
    <corners android:radius="10dp" />
    <stroke
        android:width="1dp"
        android:color="#FFDADCE0" />
</shape>
