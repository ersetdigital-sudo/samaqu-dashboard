<?xml version="1.0" encoding="utf-8"?>
<!-- Digits-only keypad for number and phone fields: three columns, four rows, rows sum to ~100%.
     Same key height as symbols.xml so the deck does not change size when it swaps in. -->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="33.33%p"
    android:keyHeight="6.4%p"
    android:horizontalGap="0dp"
    android:verticalGap="0dp">
    <Row>
        <Key android:codes="49" android:keyEdgeFlags="left" android:keyLabel="1" />
        <Key android:codes="50" android:keyLabel="2" />
        <Key android:codes="51" android:keyEdgeFlags="right" android:keyLabel="3" />
    </Row>
    <Row>
        <Key android:codes="52" android:keyEdgeFlags="left" android:keyLabel="4" />
        <Key android:codes="53" android:keyLabel="5" />
        <Key android:codes="54" android:keyEdgeFlags="right" android:keyLabel="6" />
    </Row>
    <Row>
        <Key android:codes="55" android:keyEdgeFlags="left" android:keyLabel="7" />
        <Key android:codes="56" android:keyLabel="8" />
        <Key android:codes="57" android:keyEdgeFlags="right" android:keyLabel="9" />
    </Row>
    <Row>
        <Key android:codes="-5" android:keyEdgeFlags="left" android:isRepeatable="true" android:keyLabel="⌫" />
        <Key android:codes="48" android:keyLabel="0" />
        <Key android:codes="-4" android:keyEdgeFlags="right" android:keyLabel="↵" />
    </Row>
</Keyboard>
