<?xml version="1.0" encoding="utf-8"?>
<!--
  Key preview popup. KeyboardView requires a TextView root (it casts the inflated
  view to TextView), so this stays a TextView with a rounded background.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="40dp"
    android:minHeight="48dp"
    android:background="@drawable/key_preview_bg"
    android:gravity="center"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:textColor="@color/key_text"
    android:textSize="24sp"
    android:textStyle="bold" />
