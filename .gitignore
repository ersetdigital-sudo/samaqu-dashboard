# --- Build outputs -----------------------------------------------------------
.gradle/
build/
*.aab
*.ap_

# APKs are build output, but the shipped one is committed deliberately so a clone
# has something to install without building a toolchain first. See README.
*.apk
!release/*.apk

# --- Machine-specific config -------------------------------------------------
# local.properties points at this machine's Android SDK. Anyone cloning the repo
# regenerates it (or sets ANDROID_HOME); it must never travel.
local.properties

# The release signing config falls back to the debug keystore, so nothing has to
# be checked in - and nothing here should ever hold a real production key.
*.jks
*.keystore
*.p12
*.pepk

# --- Scratch -----------------------------------------------------------------
# Log files produced while diagnosing builds.
build*.log

# --- IDE / editor ------------------------------------------------------------
.idea/
*.iml
.vscode/
captures/

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Notes -------------------------------------------------------------------
# `poc-samaqu-keyboard/.toolchain/` (JDK, Gradle, Android SDK) lives outside this
# repository on purpose: it is ~3.5 GB and belongs to each machine, not to the
# project. See README for how to build without it.
